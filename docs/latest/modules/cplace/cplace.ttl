@prefix as: <https://www.w3.org/ns/activitystreams#> .
@prefix cplace: <https://w3id.org/crima-ontology/cplace#> .
@prefix ctlo: <https://w3id.org/crima-ontology/ctlo#> .
@prefix dbo: <http://dbpedia.org/ontology/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix sosa-common: <http://www.w3.org/ns/sosa/common/> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix voaf: <http://purl.org/vocommons/voaf#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

dbo:ArchitecturalStructure rdfs:subClassOf geo:Feature,
        sosa:FeatureOfInterest .

dbo:Place rdfs:subClassOf geo:Feature,
        sosa:FeatureOfInterest .

dcterms:description a owl:AnnotationProperty .

voaf:extends a owl:AnnotationProperty .

voaf:specializes a owl:AnnotationProperty .

cplace: a owl:Ontology ;
    vann:preferredNamespacePrefix "cplace" ;
    vann:preferredNamespaceUri "https://w3id.org/crima-ontology/cplace#"^^xsd:anyURI ;
    voaf:extends ctlo: ;
    voaf:metadataVoc vann:,
        <http://purl.org/vocommons/voaf> ;
    voaf:specializes dbo:,
        <http://www.opengis.net/ont/geosparql>,
        sosa-common:,
        ctlo: ;
    owl:imports dbo:,
        <http://www.opengis.net/ont/geosparql>,
        sosa-common:,
        ctlo: .

cplace:CommunityDistrict a owl:Class ;
    rdfs:comment "es. BURGRAVIATO, VALVENOSTA, BASSAATESINA,..." ;
    rdfs:subClassOf dbo:District .

cplace:DrainageBasin a owl:Class ;
    rdfs:subClassOf dbo:NaturalPlace .

cplace:HealthDistrict a owl:Class ;
    rdfs:subClassOf dbo:District .

cplace:HealthRegion a owl:Class ;
    rdfs:comment "The sum of multiple contingous health districts (tentative)." ;
    rdfs:subClassOf dbo:GovernmentalAdministrativeRegion .

cplace:HydrologicalStation a owl:Class ;
    rdfs:isDefinedBy "International Glossary of Hydrology / Glossaire International d’Hydrologie. World Meteorological Organization, United Nations Educational, Scientific and Cultural Organization (eds.). WMO (Series), no385. WMO, Geneva (2016). ISBN 978-92-63-03385-8. ISBN 978-92-3-001154-3." ;
    rdfs:subClassOf sosa:Platform ;
    skos:definition "Hydrological station established for the observation of a specific element or elements in order to investigate hydrological events. (TR)" .

cplace:RoadNetwork a owl:Class ;
    rdfs:subClassOf dbo:Infrastructure .

cplace:Watercourse a owl:Class ;
    dcterms:description "Natural or man-made channel through or along which water may flow [9], including large interstices in the ground, such as cave, cavern or a group of these in karst terrain." ;
    rdfs:isDefinedBy "OGC® WaterML 2: Part 3 - Surface Hydrology Features (HY_Features) - Conceptual Model. Open Geospatial Consortium, 2018.",
        "http://www.opengis.net/doc/IS/hy-features/1.0" ;
    rdfs:seeAlso "International Glossary of Hydrology / Glossaire International d’Hydrologie. World Meteorological Organization, United Nations Educational, Scientific and Cultural Organization (eds.). WMO (Series), no385. WMO, Geneva (2016). ISBN 978-92-63-03385-8. ISBN 978-92-3-001154-3.",
        "http://purl.obolibrary.org/obo/ENVO_00000029 " ;
    rdfs:subClassOf dbo:Stream .

cplace:WeatherStation a owl:Class ;
    rdfs:isDefinedBy "https://en.wikipedia.org/wiki/Weather_station" ;
    rdfs:seeAlso """Guide to Meteorological Instruments and Methods of Observation. WMO-No. 8. World Meteorological Organization, 2008.
https://www.weather.gov/media/epz/mesonet/CWOP-WMO8.pdf""" ;
    rdfs:subClassOf sosa:Platform ;
    skos:definition "A weather station is a facility, either on land or sea, with instruments and equipment for measuring atmospheric conditions to provide information for weather forecasts and to study the weather and climate. The measurements taken include temperature, atmospheric pressure, humidity, wind speed, wind direction, and precipitation amounts. Wind measurements are taken with as few other obstructions as possible, while temperature and humidity measurements are kept free from direct solar radiation, or insolation." .

as:latitude a owl:DatatypeProperty ;
    rdfs:subPropertyOf geo:hasSerialization .

as:longitude a owl:DatatypeProperty ;
    rdfs:subPropertyOf geo:hasSerialization .

sosa:Platform rdfs:subClassOf geo:Feature .

