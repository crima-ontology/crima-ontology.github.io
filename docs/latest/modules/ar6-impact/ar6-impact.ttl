@prefix ar6-impact: <https://w3id.org/crima-ontology/ar6-impact#> .
@prefix cclc: <https://w3id.org/crima-ontology/cclc#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix voaf: <http://purl.org/vocommons/voaf#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

voaf:extends a owl:AnnotationProperty .

voaf:metadataVoc a owl:AnnotationProperty .

voaf:specializes a owl:AnnotationProperty .

ar6-impact: a owl:Ontology ;
    vann:preferredNamespacePrefix "ar6-impact" ;
    vann:preferredNamespaceUri "https://w3id.org/crima-ontology/ar6-impact#"^^xsd:anyURI ;
    voaf:extends <http://www.w3.org/2004/02/skos/core>,
        cclc: ;
    voaf:metadataVoc vann:,
        <http://purl.org/vocommons/voaf> ;
    voaf:specializes <http://www.w3.org/2004/02/skos/core> ;
    owl:imports <http://www.w3.org/2004/02/skos/core>,
        cclc: .

ar6-impact:AgriCropProduction a owl:NamedIndividual,
        ar6-impact:Impact-specificType .

ar6-impact:AnimalAndLivestockHealthAndProductivity a owl:NamedIndividual,
        ar6-impact:Impact-specificType .

ar6-impact:ChangesInEcosystemStructure a owl:NamedIndividual,
        ar6-impact:Impact-cluster ;
    skos:broader ar6-impact:ImpactOnEcosystems .

ar6-impact:ChangesInFreshwaterEcosystem a owl:NamedIndividual,
        ar6-impact:Impact-specificType .

ar6-impact:ChangesInOceanEcosystem a owl:NamedIndividual,
        ar6-impact:Impact-specificType .

ar6-impact:ChangesInTerrestrialEcosystem a owl:NamedIndividual,
        ar6-impact:Impact-specificType .

ar6-impact:DamagesToInfrastructure a owl:NamedIndividual,
        ar6-impact:Impact-specificType .

ar6-impact:DamagesToKeyEconomicInfrastructures a owl:NamedIndividual,
        ar6-impact:Impact-specificType .

ar6-impact:Displacement a owl:NamedIndividual,
        ar6-impact:Impact-specificType .

ar6-impact:FisheriesAndAquacultureProduction a owl:NamedIndividual,
        ar6-impact:Impact-specificType .

ar6-impact:FloodStormDamagesInCoastalAreas a owl:NamedIndividual,
        ar6-impact:Impact-specificType .

ar6-impact:FreshwaterEcosystemPhenologyChanges a owl:NamedIndividual,
        ar6-impact:Impact-specificType .

ar6-impact:FreshwaterSpeciesShift a owl:NamedIndividual,
        ar6-impact:Impact-specificType .

ar6-impact:HealthMalnutritionAndOther a owl:NamedIndividual,
        ar6-impact:Impact-specificType .

ar6-impact:ImpactOnCitiesSettlementsInfrastructures a owl:NamedIndividual,
        ar6-impact:Impact-cluster ;
    skos:broader ar6-impact:ImpactOnHumanSystems .

ar6-impact:ImpactOnHealthAndWellbeing a owl:NamedIndividual,
        ar6-impact:Impact-cluster ;
    skos:broader ar6-impact:ImpactOnHumanSystems .

ar6-impact:ImpactOnWaterScarcityAndFoodProduction a owl:NamedIndividual,
        ar6-impact:Impact-cluster ;
    skos:broader ar6-impact:ImpactOnHumanSystems .

ar6-impact:InfectiousDiseases a owl:NamedIndividual,
        ar6-impact:Impact-specificType .

ar6-impact:InlandFoodingAndAssociatedDamages a owl:NamedIndividual,
        ar6-impact:Impact-specificType .

ar6-impact:MentalHealth a owl:NamedIndividual,
        ar6-impact:Impact-specificType .

ar6-impact:OceanEcosystemPhenologyChanges a owl:NamedIndividual,
        ar6-impact:Impact-specificType .

ar6-impact:OceanSpeciesShift a owl:NamedIndividual,
        ar6-impact:Impact-specificType .

ar6-impact:PhenologyChanges a owl:NamedIndividual,
        ar6-impact:Impact-cluster ;
    skos:broader ar6-impact:ImpactOnEcosystems .

ar6-impact:SpeciesRangeShift a owl:NamedIndividual,
        ar6-impact:Impact-cluster ;
    skos:broader ar6-impact:ImpactOnEcosystems .

ar6-impact:TerrestrialEcosystemPhenologyChanges a owl:NamedIndividual,
        ar6-impact:Impact-specificType .

ar6-impact:TerrestrialSpeciesShift a owl:NamedIndividual,
        ar6-impact:Impact-specificType .

ar6-impact:WaterScarcity a owl:NamedIndividual,
        ar6-impact:Impact-specificType .

ar6-impact:observed-impacts-list a owl:NamedIndividual,
        ar6-impact:ObservedImpacts .

ar6-impact:Impact-type a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ar6-impact:ObservedImpacts ;
            owl:onProperty skos:inScheme ],
        skos:Concept .

ar6-impact:ImpactOnEcosystems a owl:NamedIndividual,
        ar6-impact:Impact-type .

ar6-impact:ImpactOnHumanSystems a owl:NamedIndividual,
        ar6-impact:Impact-type .

ar6-impact:ObservedImpacts a owl:Class ;
    rdfs:subClassOf skos:ConceptScheme .

ar6-impact:Impact-cluster a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ar6-impact:Impact-type ;
            owl:onProperty skos:broader ],
        [ a owl:Restriction ;
            owl:allValuesFrom ar6-impact:ObservedImpacts ;
            owl:onProperty skos:inScheme ],
        skos:Concept .

ar6-impact:Impact-specificType a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom ar6-impact:Impact-cluster ;
            owl:onProperty skos:broader ],
        [ a owl:Restriction ;
            owl:allValuesFrom ar6-impact:ObservedImpacts ;
            owl:onProperty skos:inScheme ],
        skos:Concept .

