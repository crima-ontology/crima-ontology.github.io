  <rdf:Description rdf:about="https://w3id.org/crima-ontology/ecv#ECV-variable">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
