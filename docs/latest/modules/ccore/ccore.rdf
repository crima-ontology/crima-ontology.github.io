  <rdf:Description rdf:about="https://w3id.org/crima-ontology/ccore#participantOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:nodeID="n16260563f62b42f1bc9a7e86ac636a9bb20"/>
    <rdfs:range rdf:resource="https://w3id.org/crima-ontology/ccore#ThreatPerdurant"/>
    <rdfs:comment>participantOf(E, P) --&gt; 
∃ G, G1, T, T1. ThreatPerdurant(P),
hasGeometry(E, G), hasTime(E, T), hasGeometry(P, G1), hasTime(P, T1),
geo:sfIntersect(G, G1), time:notDisjoint(T, T1) .

participantOf(E, P) --&gt; (EcosystemService(E) ∨ PhysicalEndurant(E)), ThreatPerdurant(P)</rdfs:comment>
  </rdf:Description>
