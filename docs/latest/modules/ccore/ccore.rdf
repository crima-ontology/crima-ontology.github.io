    <rdf:type rdf:resource="https://w3id.org/crima-ontology/ccore#TemporalPrecision"/>
    <rdfs:comment xml:lang="en">Indicates that the temporal value is known exactly at its stated resolution.</rdfs:comment>
    <rdfs:label xml:lang="en">exact precision</rdfs:label>
  </rdf:Description>
