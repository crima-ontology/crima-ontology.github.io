@prefix ccore: <https://w3id.org/crima-ontology/ccore#> .
@prefix emdat: <https://w3id.org/crima-ontology/emdat#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix voaf: <http://purl.org/vocommons/voaf#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

vann:preferredNamespacePrefix a owl:AnnotationProperty .

vann:preferredNamespaceUri a owl:AnnotationProperty .

voaf:extends a owl:AnnotationProperty .

voaf:metadataVoc a owl:AnnotationProperty .

voaf:specializes a owl:AnnotationProperty .

ccore:CascadingEvent a owl:Class .

ccore:Hazard a owl:Class .

emdat: a owl:Ontology ;
    vann:preferredNamespacePrefix "emdat" ;
    vann:preferredNamespaceUri "https://w3id.org/crima-ontology/emdat#"^^xsd:anyURI ;
    voaf:extends <http://www.w3.org/2004/02/skos/core> ;
    voaf:metadataVoc vann:,
        <http://purl.org/vocommons/voaf> ;
    voaf:specializes <http://www.w3.org/2004/02/skos/core> ;
    owl:imports <http://www.w3.org/2004/02/skos/core> .

emdat:emdat-classificationEntry a owl:Class ;
    rdfs:comment "A record-level EM-DAT classification identified by classification_key, corresponding to one full classification path in the source table." ;
    rdfs:subClassOf skos:Concept .

emdat:emdat-disasters-classification a owl:NamedIndividual,
        emdat:EMDAT-DisastersClassification ;
    rdfs:comment "The main classification tree has four levels of depth, so disasters are divided into groups, subgroups, types, and subtypes, as presented in the EM-DAT Public Table columns. The two EM-DAT disaster groups are 'Natural' and 'Technological'. The table below shows the complete tree for the 'Natural' and 'Technological' groups, with the occurrence for each subtype. Their corresponding definitions are available in the Classification Glossary." ;
    rdfs:isDefinedBy "https://doc.emdat.be/docs/data-structure-and-content/disaster-classification-system/" .

emdat:hasSubtype a owl:ObjectProperty ;
    rdfs:comment "Links a record-level EM-DAT classification to its leaf subtype concept." ;
    rdfs:range emdat:emdat-subtype .

skos:ConceptScheme a owl:Class .

emdat:emdat-group a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom emdat:EMDAT-DisastersClassification ;
            owl:onProperty skos:inScheme ],
        skos:Concept .

emdat:emdat-subgroup a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom emdat:emdat-group ;
            owl:onProperty skos:broader ],
        [ a owl:Restriction ;
            owl:allValuesFrom emdat:EMDAT-DisastersClassification ;
            owl:onProperty skos:inScheme ],
        skos:Concept .

emdat:emdat-subtype a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom emdat:emdat-type ;
            owl:onProperty skos:broader ],
        [ a owl:Restriction ;
            owl:allValuesFrom emdat:EMDAT-DisastersClassification ;
            owl:onProperty skos:inScheme ],
        skos:Concept .

emdat:emdat-type a owl:Class ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:allValuesFrom emdat:emdat-subgroup ;
            owl:onProperty skos:broader ],
        [ a owl:Restriction ;
            owl:allValuesFrom emdat:EMDAT-DisastersClassification ;
            owl:onProperty skos:inScheme ],
        skos:Concept .

skos:broader a owl:ObjectProperty .

skos:inScheme a owl:ObjectProperty .

skos:Concept a owl:Class .

emdat:EMDAT-DisastersClassification a owl:Class ;
    rdfs:isDefinedBy "https://council.science/wp-content/uploads/2019/12/Peril-Classification-and-Hazard-Glossary-1.pdf" ;
    rdfs:seeAlso "Integrated Research on Disaster Risk. (2014). Peril Classification and Hazard Glossary (IRDR DATA Publication No. 1). Beijing: Integrated Research on Disaster Risk." ;
    rdfs:subClassOf skos:ConceptScheme .

