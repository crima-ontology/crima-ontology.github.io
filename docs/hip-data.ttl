###  https://www.undrr.org/terms/hips/ch0400
hip-term:ch0400 rdf:type owl:NamedIndividual ,
                         hip-schema:SpecificHazard ;
                skos:broader hip-cluster:asphyxiant-gases ;
                skos:inScheme hip-glossary:HIP-classification-system ;
