                                   <https://www.preventionweb.net/hips-document/7b2be9c8ba19a34d> ,
                                   <https://www.preventionweb.net/hips-document/87c78595ed9eac69> ;
                dcterms:relation "Food and Agriculture Organization of the United Nations Global Soil Partnership (GSP) (FAO, 2012)."@en ;
                dcterms:rights "Creative Commons CC BY 4.0" ;
                dcterms:source <https://www.preventionweb.net/hips-document/04729d78e530de81> ,
                               <https://www.preventionweb.net/hips-document/83811861b3b3e141> ;
                dcterms:title "Salinity & Sodicity"@en ;
                xkos:causedBy hip-term:ch0501 ,
