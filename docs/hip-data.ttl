###  https://www.undrr.org/terms/hips/mh0602
hip-term:mh0602 rdf:type owl:NamedIndividual ,
                         hip-schema:SpecificHazard ;
                skos:broader hip-cluster:water-related ;
                skos:inScheme hip-glossary:HIP-classification-system ;
