                                     <https://www.preventionweb.net/hips-document/83fa94cf61c0116b> ;
                prov:wasQuotedFrom hip-document:df99e33f1939d710 .


###  https://www.undrr.org/terms/hips/mh0308
hip-term:mh0308 rdf:type owl:NamedIndividual ,
                         hip-schema:SpecificHazard ;
