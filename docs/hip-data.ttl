###  https://www.undrr.org/terms/hips/ch0504
hip-term:ch0504 rdf:type owl:NamedIndividual ,
                         hip-schema:SpecificHazard ;
                skos:broader hip-cluster:persistent-organic-pollutants-pops ;
                skos:inScheme hip-glossary:HIP-classification-system ;
