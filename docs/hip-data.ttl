###  https://www.undrr.org/terms/hips/bi0403
hip-term:bi0403 rdf:type owl:NamedIndividual ,
                         hip-schema:SpecificHazard ;
                skos:broader hip-cluster:insect-related-diseases ;
                skos:inScheme hip-glossary:HIP-classification-system ;
