                                   <https://www.preventionweb.net/hips-document/6158fe7af078528e> ,
                                   <https://www.preventionweb.net/hips-document/8b97441281c07891> ;
                dcterms:relation "Sendai Framework for Disaster Risk Reduction 2015-2030 (UNDRR, 2015)."@en ;
                dcterms:rights "Creative Commons CC BY 4.0" ;
                dcterms:source hip-document:a02dd50187fceedb ,
                               <https://www.preventionweb.net/hips-document/2331200affcd2909> ;
                dcterms:title "Lahars"@en ;
                xkos:causedBy hip-term:gh0201 ,
                              hip-term:gh0202 ,
                              hip-term:gh0203 ,
                              hip-term:gh0300 ,
                              hip-term:mh0405 ,
                              hip-term:mh0510 ,
                              hip-term:mh0600 ,
