hip-term:mh0705 rdf:type owl:NamedIndividual ,
                         hip-schema:SpecificHazard ;
                skos:broader hip-cluster:marine-related ;
                skos:inScheme hip-glossary:HIP-classification-system ;
                dcterms:created "2023-06-07T08:40:00+00:00"^^xsd:dateTime ;
                dcterms:hasPart <https://www.preventionweb.net/hips-document/47f42205a08a25d0> ;
                dcterms:identifier "MH0705" ;
                dcterms:modified "2026-02-05T13:07:14+00:00"^^xsd:dateTime ;
                dcterms:publisher "UNDRR, ISC, and contributors" ;
                dcterms:references hip-document:a7a99ff1ba1b5cc2 ,
                                   <https://www.preventionweb.net/hips-document/0b20ef02bf42c6c4> ,
                                   <https://www.preventionweb.net/hips-document/1c10acd49c570e22> ,
                                   <https://www.preventionweb.net/hips-document/1d5d84fa9e1f2c8e> ,
                                   <https://www.preventionweb.net/hips-document/16ec43e66af8a949> ,
                                   <https://www.preventionweb.net/hips-document/5e5f33e6f1f24631> ,
                                   <https://www.preventionweb.net/hips-document/7a9b3c8a9b2f0646> ;
                dcterms:relation "Sendai Framework for Disaster Risk Reduction 2015-2030."@en ;
                dcterms:rights "Creative Commons CC BY 4.0" ;
                dcterms:source <https://www.preventionweb.net/hips-document/1c10acd49c570e22> ;
                dcterms:title "Tsunami"@en ;
                xkos:causedBy hip-term:et0203 ,
                              hip-term:et0206 ,
                              hip-term:gh0101 ,
                              hip-term:gh0300 ;
                xkos:causes hip-term:bi0103 ,
                            hip-term:bi0110 ,
                            hip-term:bi0204 ,
                            hip-term:en0302 ,
                            hip-term:en0303 ,
                            hip-term:gh0306 ,
                            hip-term:gh0405 ,
                            hip-term:mh0601 ,
                            hip-term:mh0602 ,
                            hip-term:tl0201 ,
                            hip-term:tl0203 ,
