                dcterms:relation "The Sendai Framework for Disaster Risk Reduction 2015-2030 (UNDRR, 2015)."@en ;
                dcterms:rights "Creative Commons CC BY 4.0" ;
                dcterms:source <https://www.preventionweb.net/hips-document/9444c17e8e19271a> ;
                dcterms:title "Supply Chain Failure"@en ;
                xkos:causedBy hip-term:gh0101 ,
