                                     hip-document:e9fe0974df172bb0 ,
                                     <https://www.preventionweb.net/hips-document/2410dac4aa8f1b30> ,
                                     <https://www.preventionweb.net/hips-document/5055ba56e400620a> ,
                                     <https://www.preventionweb.net/hips-document/6c6cf5f8812b802a> ,
                                     <https://www.preventionweb.net/hips-document/748e8538afb0a61c> ,
                                     <https://www.preventionweb.net/hips-document/90a7c2a37b88a4a5> ,
                                     <https://www.preventionweb.net/hips-document/91237ff09f1f78fd> ;
                prov:wasQuotedFrom hip-document:d8ac86e36dd53dcf .


###  https://www.undrr.org/terms/hips/bi0230
hip-term:bi0230 rdf:type owl:NamedIndividual ,
