                              hip-term:tl0205 ;
                xkos:causes hip-term:bi0103 ,
                            hip-term:bi0110 ,
                            hip-term:en0106 ,
                            hip-term:en0301 ,
                            hip-term:gh0403 ,
                            hip-term:gh0404 ,
                            hip-term:mh0601 ,
                            hip-term:mh0606 ,
                            hip-term:tl0201 ,
                            hip-term:tl0203 ,
                            hip-term:tl0204 ,
                            hip-term:tl0205 ,
                            hip-term:tl0206 ,
                            hip-term:tl0207 ,
                            hip-term:tl0214 ,
                            hip-term:tl0404 ,
