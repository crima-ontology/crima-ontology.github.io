                dcterms:relation "United Nations Convention to Combat Desertification (UNCCD) (UNCCD, 1994)."@en ;
                dcterms:rights "Creative Commons CC BY 4.0" ;
                dcterms:source <https://www.preventionweb.net/hips-document/467980721d5a15b4> ;
                dcterms:title "Land Degradation"@en ;
                xkos:causedBy hip-term:en0201 ,
                              hip-term:en0202 ,
                              hip-term:en0203 ,
