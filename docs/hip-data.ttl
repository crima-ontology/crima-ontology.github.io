                                   <https://www.preventionweb.net/hips-document/90a0168a3b8aaa6b> ;
                dcterms:relation "The only regional legal agreement currently in place is the Agreement on Transboundary Haze Pollution of the Association of Southeast Asian Nations (ASEAN, 2002)."@en ;
                dcterms:rights "Creative Commons CC BY 4.0" ;
                dcterms:source hip-document:cb31cb80a5c54ce2 ;
                dcterms:title "Wildfires"@en ;
                xkos:causedBy hip-term:ch0300 ,
