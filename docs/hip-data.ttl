                dcterms:hasPart <https://www.preventionweb.net/hips-document/7da094d93e4a26dd> ;
                dcterms:identifier "GH0404" ;
                dcterms:modified "2026-02-06T10:13:26+00:00"^^xsd:dateTime ;
                dcterms:publisher "UNDRR, ISC, and contributors" ;
                dcterms:references hip-document:bea393e13b607367 ,
                                   hip-document:c4749d83506d870e ,
