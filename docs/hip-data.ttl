###  https://www.undrr.org/terms/hips/ch0103
hip-term:ch0103 rdf:type owl:NamedIndividual ,
                         hip-schema:SpecificHazard ;
                skos:broader hip-cluster:heavy-metals-trace-elements ;
                skos:inScheme hip-glossary:HIP-classification-system ;
                skos:related <https://unece.org/transport/dangerous-goods/ghs-rev10-2023#GHS07> ,
                             <https://unece.org/transport/dangerous-goods/ghs-rev10-2023#GHS08> ,
                             <https://unece.org/transport/dangerous-goods/ghs-rev10-2023#GHS09> ;
                dcterms:conformsTo hip-document:e94c5f916bb17a5e ;
                dcterms:created "2023-06-07T08:40:00+00:00"^^xsd:dateTime ;
                dcterms:hasPart hip-document:c19b9d711c1f8255 ;
                dcterms:identifier "CH0103" ;
                dcterms:modified "2026-01-27T15:33:24+00:00"^^xsd:dateTime ;
                dcterms:publisher "UNDRR, ISC, and contributors" ;
                dcterms:references hip-document:c0a424a0743a074a ,
                                   hip-document:ca951c1c0195b134 ,
