###  https://www.undrr.org/terms/hips/gh0404
hip-term:gh0404 rdf:type owl:NamedIndividual ,
                         hip-schema:SpecificHazard ;
                skos:broader hip-cluster:other-geohazard ;
                skos:inScheme hip-glossary:HIP-classification-system ;
