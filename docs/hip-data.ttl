                              hip-term:tl0309 ,
                              hip-term:tl0502 ,
                              hip-term:tl0509 ;
                xkos:causes hip-term:ch0100 ,
                            hip-term:ch0300 ,
                            hip-term:ch0503 ,
                            hip-term:en0101 ,
                            hip-term:en0102 ,
