                                     <https://www.preventionweb.net/hips-document/54b3a5590c70daa8> ,
                                     <https://www.preventionweb.net/hips-document/573328bbbcf7a493> ,
                                     <https://www.preventionweb.net/hips-document/7d1a7d8b8a039317> ;
                prov:wasQuotedFrom hip-document:c4b8e4f4b1d487a0 .


###  https://www.undrr.org/terms/hips/tl0405
hip-term:tl0405 rdf:type owl:NamedIndividual ,
                         hip-schema:SpecificHazard ;
                skos:broader hip-cluster:transportation-accidents ;
                skos:inScheme hip-glossary:HIP-classification-system ;
                dcterms:created "2023-06-07T08:40:00+00:00"^^xsd:dateTime ;
