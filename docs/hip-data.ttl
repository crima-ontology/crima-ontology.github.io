                dcterms:identifier "BI0108" ;
                dcterms:modified "2026-01-27T12:59:58+00:00"^^xsd:dateTime ;
                dcterms:publisher "UNDRR, ISC, and contributors" ;
                dcterms:references hip-document:b42248b636b935ea ,
                                   hip-document:c0b52b2bd010df25 ,
                                   hip-document:c7e59d0bba13a3b7 ,
                                   hip-document:d8aa05379517b312 ,
                                   hip-document:def35570a794619e ,
                                   hip-document:dffb8bac2baf0b0e ,
                                   hip-document:e564336f6f99a184 ,
                                   hip-document:e8bb142a552153c9 ,
