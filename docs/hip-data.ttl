                skos:inScheme hip-glossary:HIP-classification-system ;
                dcterms:created "2023-06-07T08:40:00+00:00"^^xsd:dateTime ;
                dcterms:identifier "BI0112" ;
                dcterms:modified "2025-11-12T03:22:05+00:00"^^xsd:dateTime ;
                dcterms:publisher "UNDRR, ISC, and contributors" ;
                dcterms:references hip-document:a085419c70d65d3b ,
                                   hip-document:a4f8bfa83ea7db1c ,
                                   hip-document:ad0e755657768467 ,
                                   hip-document:b04fe1902c9bb094 ,
                                   hip-document:b262235cb19d6552 ,
                                   hip-document:ba4a93dcf4102801 ,
                                   hip-document:c50388adca805e2f ,
                                   hip-document:e34309184481c583 ,
                                   hip-document:e43a8d40fad3f0b9 ,
                                   hip-document:e9b5861599af2467 ,
                                   <https://www.preventionweb.net/hips-document/006b744d1127525a> ,
                                   <https://www.preventionweb.net/hips-document/1eed1906cadf6c12> ,
                                   <https://www.preventionweb.net/hips-document/14c00fe819fcf7fd> ,
                                   <https://www.preventionweb.net/hips-document/1452083505cb3a42> ,
