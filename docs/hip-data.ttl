###  https://www.undrr.org/terms/hips/ch0201
hip-term:ch0201 rdf:type owl:NamedIndividual ,
                         hip-schema:SpecificHazard ;
                skos:broader hip-cluster:carcinogens ;
                skos:inScheme hip-glossary:HIP-classification-system ;
                skos:related <https://unece.org/transport/dangerous-goods/ghs-rev10-2023#GHS06> ,
                             <https://unece.org/transport/dangerous-goods/ghs-rev10-2023#GHS08> ;
                dcterms:conformsTo hip-document:e94c5f916bb17a5e ;
                dcterms:created "2023-06-07T08:40:00+00:00"^^xsd:dateTime ;
                dcterms:hasPart <https://www.preventionweb.net/hips-document/963d209fcc8dcea1> ;
                dcterms:identifier "CH0201" ;
                dcterms:modified "2026-01-27T13:37:54+00:00"^^xsd:dateTime ;
                dcterms:publisher "UNDRR, ISC, and contributors" ;
                dcterms:references hip-document:be9a612aa5d90608 ,
                                   hip-document:c63bd4797ac16cf9 ,
