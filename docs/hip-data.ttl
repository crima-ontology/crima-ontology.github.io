hip-term:tl0213 rdf:type owl:NamedIndividual ,
                         hip-schema:SpecificHazard ;
                skos:broader hip-cluster:construction-structural-failure ;
                skos:inScheme hip-glossary:HIP-classification-system ;
                dcterms:created "2025-06-02T16:34:05+00:00"^^xsd:dateTime ;
                dcterms:hasPart <https://www.preventionweb.net/hips-document/5f9294f938facbf3> ;
