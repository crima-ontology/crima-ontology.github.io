                                   <https://www.preventionweb.net/hips-document/0a1457d94c8da7e4> ,
                                   <https://www.preventionweb.net/hips-document/11ea286e74981b34> ,
                                   <https://www.preventionweb.net/hips-document/5f701ab52f513c9f> ,
                                   <https://www.preventionweb.net/hips-document/9d65ceaffe43c495> ;
                dcterms:relation "The Convention on Nuclear Safety, adopted 1994, aims to commit Contracting Parties operating land-based civil nuclear power plants to maintain a high level of safety by establishing fundamental safety principles to which States would subscribe. The Convention is based on the Parties' common interest to achieve higher levels of safety that will be developed and promoted through regular meetings (IAEA, 1994)."@en ;
                dcterms:rights "Creative Commons CC BY 4.0" ;
                dcterms:source hip-document:fc43e58685865201 ;
                dcterms:title "Nuclear Plant Failure"@en ;
                xkos:causedBy hip-term:gh0101 ,
                              hip-term:gh0201 ,
