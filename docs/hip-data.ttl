                                   <https://www.preventionweb.net/hips-document/83152154a391161c> ;
                dcterms:relation "Sendai Framework for Disaster Risk Reduction 2015-2030."@en ;
                dcterms:rights "Creative Commons CC BY 4.0" ;
                dcterms:source <https://www.preventionweb.net/hips-document/674f361319f9dfed> ;
                dcterms:title "Fluvial (Riverine) Flooding"@en ;
                xkos:causedBy hip-term:mh0309 ,
                              hip-term:mh0402 ,
                              hip-term:mh0601 ,
