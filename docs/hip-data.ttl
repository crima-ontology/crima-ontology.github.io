                skos:inScheme hip-glossary:HIP-classification-system ;
                dcterms:created "2023-06-07T08:40:00+00:00"^^xsd:dateTime ;
                dcterms:hasPart <https://www.preventionweb.net/hips-document/71e55ea9333da60e> ;
