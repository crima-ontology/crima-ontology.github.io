###  https://www.undrr.org/terms/hips/bi0601
hip-term:bi0601 rdf:type owl:NamedIndividual ,
                         hip-schema:SpecificHazard ;
                skos:broader hip-cluster:other-biological-hazards ;
                skos:inScheme hip-glossary:HIP-classification-system ;
                dcterms:created "2023-06-07T08:40:00+00:00"^^xsd:dateTime ;
                dcterms:hasPart hip-document:e4c28767c1e48570 ;
                dcterms:identifier "BI0601" ;
                dcterms:modified "2026-01-27T12:40:22+00:00"^^xsd:dateTime ;
