###  https://www.undrr.org/terms/hips/en0105
hip-term:en0105 rdf:type owl:NamedIndividual ,
                         hip-schema:SpecificHazard ;
                skos:broader hip-cluster:environmental-degradation ;
                skos:inScheme hip-glossary:HIP-classification-system ;
                dcterms:created "2023-06-07T08:40:00+00:00"^^xsd:dateTime ;
                dcterms:hasPart hip-document:c59ca34360ebcf47 ;
                dcterms:identifier "EN0105" ;
                dcterms:modified "2026-01-26T13:04:10+00:00"^^xsd:dateTime ;
                dcterms:publisher "UNDRR, ISC, and contributors" ;
                dcterms:references hip-document:cea2620b0f1751a2 ,
                                   hip-document:fa3c07cfa7645c13 ,
                                   <https://www.preventionweb.net/hips-document/0a9c7dd76df10669> ,
                                   <https://www.preventionweb.net/hips-document/0cba6a8aa0c3851e> ,
                                   <https://www.preventionweb.net/hips-document/43caac683d89bb80> ,
                                   <https://www.preventionweb.net/hips-document/77723317f5d6392e> ,
                                   <https://www.preventionweb.net/hips-document/852861feec8e42fb> ,
