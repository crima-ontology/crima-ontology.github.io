                                   <https://www.preventionweb.net/hips-document/981cc2d9f24e4602> ;
                dcterms:relation "Sendai Framework for Disaster Risk Reduction 2015-2030."@en ;
                dcterms:rights "Creative Commons CC BY 4.0" ;
                dcterms:source hip-document:d85ab38b5e44c129 ,
                               hip-document:f2439175f2eac845 ;
                dcterms:title "Household Air Pollution"@en ;
                xkos:causedBy hip-term:ch0202 ,
                              hip-term:ch0300 ,
                              hip-term:ch0301 ,
                              hip-term:ch0400 ,
                              hip-term:ch0901 ,
                              hip-term:en0102 ,
                              hip-term:en0103 ,
                              hip-term:en0205 ,
                              hip-term:gh0205 ,
                              hip-term:gh0407 ,
                              hip-term:so0101 ,
                              hip-term:so0102 ,
                              hip-term:so0103 ,
                              hip-term:tl0201 ,
                              hip-term:tl0202 ,
                              hip-term:tl0203 ,
                              hip-term:tl0208 ,
                              hip-term:tl0301 ,
                              hip-term:tl0302 ,
                              hip-term:tl0304 ,
                              hip-term:tl0305 ,
                              hip-term:tl0306 ,
                              hip-term:tl0308 ,
                              hip-term:tl0309 ,
                              hip-term:tl0501 ,
                              hip-term:tl0502 ,
