                               hip-document:f655520c22626da2 ;
                dcterms:title "Ash/Tephra Fall (including Volcanic Ballistic Projectiles)"@en ;
                xkos:causedBy hip-term:gh0203 ,
                              hip-term:gh0204 ;
                xkos:causes hip-term:en0205 ,
                            hip-term:gh0203 ,
                            hip-term:gh0204 ,
                            hip-term:tl0201 ,
                            hip-term:tl0203 ,
                            hip-term:tl0204 ,
