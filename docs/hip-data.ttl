                                   <https://www.preventionweb.net/hips-document/5370fc20649756b4> ,
                                   <https://www.preventionweb.net/hips-document/58fb205ae1e8d8e1> ;
                dcterms:relation "Basel Convention: Controls transboundary movement of hazardous wastes including trace elements."@en ;
                dcterms:rights "Creative Commons CC BY 4.0" ;
                dcterms:source <https://www.preventionweb.net/hips-document/402f9000c8379199> ;
                dcterms:title "Heavy Metals and Other Trace Elements"@en ;
                xkos:causedBy hip-term:en0105 ,
                              hip-term:en0106 ,
                              hip-term:en0205 ,
                              hip-term:en0403 ,
                              hip-term:tl0301 ,
                              hip-term:tl0302 ,
                              hip-term:tl0303 ,
                              hip-term:tl0304 ,
                              hip-term:tl0305 ,
                              hip-term:tl0307 ,
