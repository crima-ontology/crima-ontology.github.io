###  https://www.undrr.org/terms/hips/ch0202
hip-term:ch0202 rdf:type owl:NamedIndividual ,
                         hip-schema:SpecificHazard ;
                skos:broader hip-cluster:carcinogens ;
                skos:inScheme hip-glossary:HIP-classification-system ;
                skos:related <https://unece.org/transport/dangerous-goods/ghs-rev10-2023#GHS07> ,
                             <https://unece.org/transport/dangerous-goods/ghs-rev10-2023#GHS08> ;
                dcterms:conformsTo hip-document:e94c5f916bb17a5e ;
                dcterms:created "2023-06-07T08:40:00+00:00"^^xsd:dateTime ;
                dcterms:hasPart <https://www.preventionweb.net/hips-document/22846ded2d73faec> ;
                dcterms:identifier "CH0202" ;
                dcterms:modified "2026-01-27T13:42:05+00:00"^^xsd:dateTime ;
                dcterms:publisher "UNDRR, ISC, and contributors" ;
                dcterms:references hip-document:a4d5d8d3d32a8c1f ,
                                   hip-document:b0c34bdb5ba65f7e ,
