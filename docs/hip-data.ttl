###  https://www.undrr.org/terms/hips/gh0203
hip-term:gh0203 rdf:type owl:NamedIndividual ,
                         hip-schema:SpecificHazard ;
                skos:broader hip-cluster:volcanic ;
                skos:inScheme hip-glossary:HIP-classification-system ;
