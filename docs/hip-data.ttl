                                     <https://www.preventionweb.net/hips-document/6740b8c8dd61807b> ,
                                     <https://www.preventionweb.net/hips-document/8617c74b6ad0b4fa> ;
                prov:wasQuotedFrom <https://www.preventionweb.net/hips-document/0d780cd45de6e942> ,
                                   <https://www.preventionweb.net/hips-document/1710b160b9911720> .


###  https://www.undrr.org/terms/hips/gh0204
hip-term:gh0204 rdf:type owl:NamedIndividual ,
