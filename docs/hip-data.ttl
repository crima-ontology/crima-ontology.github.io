                prov:wasQuotedFrom <https://www.preventionweb.net/hips-document/391126ed440f5e00> .


###  https://www.undrr.org/terms/hips/so0102
hip-term:so0102 rdf:type owl:NamedIndividual ,
                         hip-schema:SpecificHazard ;
                skos:broader hip-cluster:conflict ;
                skos:inScheme hip-glossary:HIP-classification-system ;
                dcterms:created "2023-06-07T08:40:00+00:00"^^xsd:dateTime ;
