                                   <https://www.preventionweb.net/hips-document/8f24786906d34446> ;
                dcterms:relation "International Health Regulations (2005), 3rd ed. (WHO, 2016b)."@en ;
                dcterms:rights "Creative Commons CC BY 4.0" ;
